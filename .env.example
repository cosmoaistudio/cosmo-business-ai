# =============================================================================
# Web (Vite / Vercel) — somente valores públicos
# Cadastre estas duas no painel da Vercel (Production e Preview).
# NÃO cadastre service role nem COSMO_SUPABASE_SERVICE_ROLE_KEY.
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Opcional — /download. Sem override, o Setup usa a GitHub Release v1.0.0-rc.3.
# Portable só preencha quando o asset existir na Release.
# VITE_COSMO_WINDOWS_SETUP_URL=
# VITE_COSMO_WINDOWS_PORTABLE_URL=

# =============================================================================
# Local / scripts — NÃO usar no painel da Vercel
# Desktop Agent + service role: copie .env.desktop.example → .env.desktop
# =============================================================================

# Impressora local (não é variável VITE_ — não entra no bundle web)
COSMO_ORGANIZATION_ID=your-organization-uuid
COSMO_PRINTER_HOST=192.168.1.100
COSMO_PRINTER_PORT=9100
COSMO_PRINTER_DRIVER=epson

# OAuth Desktop: cadastre também no Supabase Redirect URLs:
# http://127.0.0.1:47821/auth/desktop-complete
# (landing de sucesso no navegador → deep link cosmobusiness://auth/callback)

# Opcional: credenciais para scripts de validação automatizada
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# Desktop updater: teste local apenas. Produção = GitHub Releases (sem token).
# COSMO_UPDATE_SERVER_URL=http://127.0.0.1:8787/
