VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Desktop Agent (Electron)
COSMO_ORGANIZATION_ID=your-organization-uuid
COSMO_PRINTER_HOST=192.168.1.100
COSMO_PRINTER_PORT=9100
COSMO_PRINTER_DRIVER=epson

# OAuth Desktop: cadastre também no Supabase Redirect URLs:
# http://127.0.0.1:47821/auth/desktop-complete
# (landing de sucesso no navegador → deep link cosmobusiness://auth/callback)

# Opcional: credenciais para scripts de validação automatizada
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# Desktop updater: teste local apenas. Produção = GitHub Releases (sem token).
# COSMO_UPDATE_SERVER_URL=http://127.0.0.1:8787/
