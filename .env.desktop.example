# Cosmo Desktop — credenciais exclusivas do Electron Main (NÃO compartilhar com Vite/React)
# Copie este arquivo para .env.desktop na raiz do projeto.

# URL do projeto Supabase (Main only — não use prefixo VITE_)
COSMO_SUPABASE_URL=https://your-project.supabase.co

# Service Role Key — NUNCA colocar no .env do Vite ou no frontend
COSMO_SUPABASE_SERVICE_ROLE_KEY=

# Organização atendida por este terminal
COSMO_ORGANIZATION_ID=

# Identificador do agente (opcional na primeira instalação; deixe vazio para auto-registro)
COSMO_AGENT_ID=

# Nome exibido deste terminal/desktop
COSMO_AGENT_NAME=Cosmo Desktop PDV

# Atualização remota: produção = GitHub Releases (sem token no app).
# Override HTTP só para teste local do updater. Não use em loja.
# COSMO_UPDATE_SERVER_URL=http://127.0.0.1:8787/
